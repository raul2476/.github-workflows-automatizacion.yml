# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Numero de WhatsApp de Twilio (sandbox o aprobado), formato E.164 con prefijo whatsapp:
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Agente (Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# --- Servidor ---
PORT=3000
# En "production" se valida la firma X-Twilio-Signature de cada webhook
NODE_ENV=development

# --- Limite de mensajes por numero (evita quemar tokens por spam/loops) ---
RATE_LIMIT_MAX_MESSAGES=20
RATE_LIMIT_WINDOW_MS=3600000

# --- Informe final: Google Drive + correo ---
# JSON completo de la service account de Google Cloud (o el mismo JSON en base64).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}
# ID de la carpeta raiz en Drive (dentro de nextlevelopsconsultinspa@gmail.com)
# compartida con el email de la service account. Se saca de la URL de la carpeta:
# https://drive.google.com/drive/folders/<ESTE_ID>
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Cuenta de Gmail que envia el correo (App Password, no la contrasena normal)
GMAIL_SENDER_EMAIL=nextlevelopsconsultinspa@gmail.com
GMAIL_APP_PASSWORD=

# A quien se le manda el informe (el "contador")
CONTADOR_EMAIL=nextlevelopsconsultinspa@gmail.com
